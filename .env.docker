# ----------------------------------------------------------------------------
# .env.docker — compose-only defaults. Copy to .env before `docker compose up`
# (or rely on compose's `env_file:` if you keep this filename).
# Real secrets (Alpaca, Anthropic, Gemini, Robinhood) belong in .env.local and
# are read-through to the relevant services via `environment:` overrides.
# ----------------------------------------------------------------------------

# --- Postgres -----------------------------------------------------------------
POSTGRES_USER=vegaedge
POSTGRES_PASSWORD=vegaedge_dev_pw
POSTGRES_DB=vegaedge
# DSNs each service uses. Roles created in infra/postgres/init.sql.
PRICING_PG_DSN=postgresql+asyncpg://pricing_ro:pricing_ro_pw@postgres:5432/vegaedge
DATA_PG_DSN=postgresql+asyncpg://data_rw:data_rw_pw@postgres:5432/vegaedge
PORTFOLIO_PG_DSN=postgresql+asyncpg://portfolio_rw:portfolio_rw_pw@postgres:5432/vegaedge
LLM_PG_DSN=postgresql+asyncpg://llm_ro:llm_ro_pw@postgres:5432/vegaedge
WORKER_PG_DSN=postgresql+asyncpg://worker_rw:worker_rw_pw@postgres:5432/vegaedge

# --- Mongo --------------------------------------------------------------------
MONGO_INITDB_ROOT_USERNAME=vegaedge
MONGO_INITDB_ROOT_PASSWORD=vegaedge_dev_pw
MONGO_URI=mongodb://vegaedge:vegaedge_dev_pw@mongo:27017/vegaedge?authSource=admin

# --- Redis --------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# --- Frontend wiring ----------------------------------------------------------
# Browser hits NPM, which forwards by path to the right backend service.
# Server-side Next.js rewrites also go through NPM via this hostname.
BACKEND_URL=npm

# --- Backend CORS (NPM terminates at host :80) --------------------------------
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# --- Logging ------------------------------------------------------------------
LOG_LEVEL=INFO
BACKEND_LOG_DIR=/app/logs

# --- App auth (override in .env.local) ---------------------------------------
APP_PASSWORD_HASH=
APP_SESSION_SECRET=change-me-in-env-local
APP_SESSION_TTL_SEC=604800
APP_SESSION_COOKIE_SECURE=false

# --- External API keys (override in .env.local) ------------------------------
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
ROBINHOOD_USERNAME=
ROBINHOOD_PASSWORD=
ROBINHOOD_TOTP_SECRET=
MARKET_PROVIDER=yfinance
FLOW_WATCHLIST=
