# Anthropic Claude — Fundamentals Regime-Shift Scanner (/stock/[ticker] → "Regime Shift" tab)
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-sonnet-4-6.
# REGIME_SHIFT_MODEL=claude-sonnet-4-6

# VegaEdge Live Agent / Gemini
GEMINI_API_KEY=
# Optional: GOOGLE_API_KEY (used if GEMINI_API_KEY not set)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Optional. Text model used by the IR thesis classifier
# (data/ir_classifier.py). Default if unset: gemini-2.5-flash.
# Falls back to a lexicon scan when no API key is configured.
IR_CLASSIFIER_MODEL=gemini-2.5-flash

# Existing backend (optional)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Market-data provider for src/data/market_provider.py.
#   yfinance  (default) — Yahoo Finance, no auth, increasingly rate-limited
#   rh                  — Robinhood only (authenticated, faster, but only
#                         supports quotes/history-≤5y/options/basic fundamentals)
#   composite           — Robinhood primary, yfinance fallback. Recommended
#                         when ROBINHOOD_USERNAME/PASSWORD are configured.
# MARKET_PROVIDER=composite

# Flow scanner (the /flow page) — daily option-chain snapshot watchlist.
# Comma-separated tickers replace the built-in default of liquid ETFs +
# mega-cap names (SPY/QQQ/IWM/NVDA/AAPL/...). Live Robinhood holdings are
# always added on top regardless of this setting, so your own positions
# are always covered.
# FLOW_WATCHLIST=SPY,QQQ,NVDA,TSLA,AMD
