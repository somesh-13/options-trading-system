# VegaEdge Live Agent / Gemini
GEMINI_API_KEY=
# Optional: GOOGLE_API_KEY (used if GEMINI_API_KEY not set)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Alpaca Paper Trading (free account at https://alpaca.markets)
# 1. Sign up at alpaca.markets → go to Paper Trading → generate API keys
# 2. Fill in your keys below:
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets
# NOTE: Only paper trading is supported. The server will refuse to start
# if ALPACA_BASE_URL points to a live trading endpoint.
