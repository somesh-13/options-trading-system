# VegaEdge Live Agent / Gemini
GEMINI_API_KEY=
# Optional: GOOGLE_API_KEY (used if GEMINI_API_KEY not set)
GEMINI_MODEL=gemini-2.5-flash-native-audio-preview-12-2025
# Optional. Text model used by the IR thesis classifier
# (data/ir_classifier.py). Default if unset: gemini-2.5-flash.
# Falls back to a lexicon scan when no API key is configured.
IR_CLASSIFIER_MODEL=gemini-2.5-flash

# Existing backend (optional)
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets
